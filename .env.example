RESEND_API_KEY=
BIRDSHOP_SITE_URL=
BIRDSHOP_EMAIL_FROM=
BIRDSHOP_ADMIN_EMAIL=
BIRDSHOP_RATE_LIMIT_SECRET=
CRON_SECRET=
