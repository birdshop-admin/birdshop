{
  "name": "birdshop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck",
    "test:storefront": "playwright test",
    "test:marketplace": "npm run test:unit --workspace @birdshop/marketplace",
    "build:marketplace": "npm run build --workspace @birdshop/marketplace",
    "check:marketplace": "npm run check --workspace @birdshop/marketplace",
    "test:marketplace:browser": "npm run test:browser --workspace @birdshop/marketplace --",
    "check:isolation": "node scripts/check-app-isolation.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "server-only": "0.0.1",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "workspaces": [
    "apps/*"
  ]
}
